+        /* Native IS_UNCOLLECTABLE uses (kind & ~1) == 2. Its permanently marked
+         * padding bits are not an occupancy measure; retain those chains.
+         */
+        if ((kind & ~1) == 2) continue;
+        if (!pending) continue;
+        for (size = 1; size <= 256; ++size) {
+            u64 block = pending[size];
+            while (block) {
+                FreeHeader* h = find(block);
+                if (++count > MAX_BLOCKS || (u64)h <= 4096 || (block & 4095)
+                    || h->bytes != size || h->kind != kind || (h->flags & 2)
+                    || marked(h) > 512 / size) { state->rejected++; return; }
